{
  "name": "kanjipain",
  "version": "0.1.0",
  "private": true,
  "description": "Effortful kanji recall practice.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --config vite.e2e.config.ts",
    "preview": "vite preview",
    "preview:e2e": "vite preview --outDir dist-e2e",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:fetch": "tsx scripts/fetch-kanjidic.ts",
    "data:import": "tsx scripts/import-kanjidic.ts",
    "data:validate": "tsx scripts/validate-catalog.ts",
    "strokes:fetch": "tsx scripts/fetch-kanjivg.ts",
    "strokes:import": "tsx scripts/import-kanjivg.ts",
    "checker:selftest": "tsx scripts/checker-selftest.ts",
    "e2e:fixtures": "tsx scripts/generate-e2e-fixtures.ts",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run data:validate && npm run test"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "5.3.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "ts-fsrs": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.8",
    "fast-xml-parser": "5.12.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
